{
  "name": "scene-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:sync": "node scripts/sync-api.mjs && npm run api:types",
    "api:types": "openapi-typescript openapi/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-query": "^5.0.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "zustand": "^5.0.0",
    "use-intl": "^4.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "jsdom": "^30.1.3",
    "msw": "^2.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "vite": "^6.4.0",
    "@vitejs/plugin-react": "^4.7.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.62.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
