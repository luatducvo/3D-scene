# Compose
COMPOSE_PROJECT_NAME=scene-backend

# Storage
DATA_DIR=/data
MODELS_DIR=/models
HOST_MODELS_DIR=./models

# PostgreSQL
POSTGRES_USER=scene
POSTGRES_PASSWORD=scene
POSTGRES_DB=scene
DATABASE_URL=postgresql://scene:scene@postgres:5432/scene

# API
CORS_ORIGINS=http://localhost:3000

# Pipeline: pipeline.fake.yaml (skeleton), pipeline.fake-gpu.yaml (fakes on Modal), pipeline.yaml (real)
PIPELINE_CONFIG=/app/backend/config/pipeline.fake.yaml
COMPUTE_CONFIG=/app/backend/config/compute.yaml

# Compute targets (only the ones you use)
COMPUTE_TOKEN=
MODAL_COMPUTE_URL=
MODAL_RECON_URL=
MODAL_PERCEPTION_URL=
RUNPOD_POD_URL=
RUNPOD_SERVERLESS_URL=
RUNPOD_API_KEY=
GENERIC_COMPUTE_URL=
COMPUTE_IMAGE=ghcr.io/<owner>/scene-compute:latest
LOCAL_GPU_EXTRAS=

# Hugging Face (gated weights)
HF_TOKEN=

# LLM (questions) and VLM (attributes): any OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
