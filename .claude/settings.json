{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["colab-mcp"],
  "permissions": {
    "allow": [
      "Bash(uv run main.py --help)",
      "Bash(uv run main.py test)",
      "Bash(uv run main.py test *)",
      "Bash(uv run main.py test-unit)",
      "Bash(uv run main.py test-unit *)",
      "Bash(uv run main.py lint)",
      "Bash(uv run main.py lint *)",
      "Bash(uv run main.py format)",
      "Bash(uv run main.py format *)",
      "Bash(uv run main.py openapi)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run api:sync)",
      "Bash(npm --prefix frontend run typecheck)",
      "Bash(npm --prefix frontend test)",
      "Bash(npm --prefix frontend run build)",
      "Bash(npm --prefix frontend run api:sync)",
      "Bash(git commit *)"
    ],
    "ask": [
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Edit(/backend/openapi/openapi.json)",
      "Edit(/frontend/openapi/openapi.json)",
      "Edit(/frontend/src/lib/api/schema.d.ts)",
      "Bash(git push)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
