  "cards": [
    {
      "dot": "emerald",
      "title": "Job pipeline",
      "items": [
        "POST /process inserts a Job; the worker claims it with FOR UPDATE SKIP LOCKED every 0.5 s",
        "Nine Stages in order: ingest → recon → align → mesh → segment → lift → embed → attributes → graph",
        "Each Stage is one Compute Run; progress lands in stage_runs + scene_events and the API streams it as SSE"
      ]
    },
    {
      "dot": "cyan",
      "title": "Publication",
      "items": [
        "Only results (graph, embeddings, mesh) leave the Target; intermediates stay there (ADR-0005)",
        "Results land in staging, are renamed to /scenes/{id}/{job}, then one transaction writes Objects + Relations and marks the Scene ready (ADR-0006)"
      ]
    },
    {
      "dot": "violet",
      "title": "Targets",
      "items": [
        "GPU_TARGET names one Target in compute.yaml; there is no default",
        "cpu runs Algorithms in-process (fake pipeline); local_gpu, vast, colab, modal and runpod reach scene-compute over HTTP",
        "The token check applies only when COMPUTE_TOKEN is set; local_gpu runs without one"
      ]
    },
    {
      "dot": "amber",
      "title": "Grounded QA",
      "items": [
        "The QA agent loops LLM tool calls over geometric SceneTools and rejects numbers no tool returned",
        "Search and find_objects embed the query text on the Target, then rank Objects by pgvector cosine similarity"
      ]
    }
  ]
