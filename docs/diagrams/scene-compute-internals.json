  "cards": [
    {
      "dot": "emerald",
      "title": "Why asynchronous",
      "items": [
        "A Stage can take minutes to hours, but each HTTP request is cut off after 29 s",
        "So POST /runs returns at once and the worker polls GET /runs until done or failed"
      ]
    },
    {
      "dot": "violet",
      "title": "One GPU, one job at a time",
      "items": [
        "The ThreadPool has one thread, so Stage runs and embed_text queries never share the GPU",
        "While a Workspace has an active run, upload and delete return WORKSPACE_BUSY"
      ]
    },
    {
      "dot": "cyan",
      "title": "Pluggable Algorithms",
      "items": [
        "Registry resolves names like recon.da3 or segment.sam3 from scene_stages entry points",
        "Algorithms only read and write Workspace folders; they never see HTTP or the database"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure handling",
      "items": [
        "Errors become a failed record with code and message, which the worker re-raises",
        "On restart, queued or running records become COMPUTE_INTERRUPTED"
      ]
    }
  ]
