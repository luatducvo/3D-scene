# Treat architecture diagram HTML files as documentation in GitHub language statistics.
docs/diagrams/** linguist-documentation=true

# Treat the diagram-design skill's example HTML as documentation too.
.agents/skills/diagram-design/assets/** linguist-documentation=true
.claude/skills/diagram-design/assets/** linguist-documentation=true

# Treat the archify skill's HTML templates and examples as documentation.
.agents/skills/archify/**/*.html linguist-documentation=true
.claude/skills/archify/**/*.html linguist-documentation=true

# Agent skills ship third-party JS (renderers, vendored libraries); exclude
# them from GitHub language statistics so they don't outweigh the project's code.
.agents/skills/** linguist-vendored=true
.claude/skills/** linguist-vendored=true
