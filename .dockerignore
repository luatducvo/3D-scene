# All images build from the repository root using this shared context filter.
**
!Dockerfile.*
!pyproject.toml
!uv.lock
!backend/
# Re-exclude children before allowing specific backend directories below.
backend/*
!backend/packages/
!backend/packages/**
!backend/services/
!backend/services/**
!backend/config/
!backend/config/**
!backend/migrations/
!backend/migrations/**
!frontend/
!frontend/**

# Never send local artifacts or secrets nested inside the included directories.
**/.env
**/.env.*
!**/.env.example
**/.aws
**/.git
**/.venv
**/venv
**/env
**/ENV
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/build
**/dist
**/.cache
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.ipynb_checkpoints
**/.coverage
**/.coverage.*
**/coverage
**/htmlcov
**/node_modules
**/.next
**/out
**/next-env.d.ts
**/*.tsbuildinfo
**/.npm
**/playwright-report
**/test-results
**/.vscode
**/.idea
**/*.log
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
